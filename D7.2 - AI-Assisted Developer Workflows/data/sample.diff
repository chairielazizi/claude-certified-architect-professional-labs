+
+
+@router.get("/history/{customer_email}")
+def get_order_history(customer_email: str, discount: int = 0):
+    conn = get_connection()
+    rows = conn.execute(
+        f"SELECT id, total_cents FROM orders WHERE email = '{customer_email}'"
+    ).fetchall()
+    result = []
+    for row in rows:
+        total = apply_discount(row["total_cents"], discount)
+        result.append({"id": row["id"], "total_cents": total})
+    return result
